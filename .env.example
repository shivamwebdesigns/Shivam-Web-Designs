# ShivamWebDesigns Environment Configuration

# Base URL of the website
NEXT_PUBLIC_SITE_URL=https://shivamwebdesigns.devs.li

# Agency email recipient for general contact messages
CONTACT_EMAIL=shivamwebdesigns23@gmail.com

# Required for automatic email delivery from the project inquiry form
# Create an API key at https://resend.com
RESEND_API_KEY=

# Must be a sender address verified in your Resend account
CONTACT_FROM_EMAIL=ShivamWebDesigns <inquiries@your-verified-domain.com>

# Firebase Web App settings (public config used only for Google sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (server-only; never use NEXT_PUBLIC_ here)
# Copy these three values from the Firebase service-account JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_EMAIL=shivamwebdesigns23@gmail.com
