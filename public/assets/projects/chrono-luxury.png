<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" fill="none">
  <rect width="1200" height="750" fill="#0a0a0a"/>
  <rect x="30" y="30" width="1140" height="690" rx="16" stroke="#222222" stroke-width="2" fill="#0d0d0d"/>
  <!-- Top browser-style bar -->
  <line x1="30" y1="90" x2="1170" y2="90" stroke="#1c1c1c" stroke-width="1.5"/>
  <circle cx="60" cy="60" r="6" fill="#333"/>
  <circle cx="80" cy="60" r="6" fill="#333"/>
  <circle cx="100" cy="60" r="6" fill="#333"/>
  <rect x="130" y="46" width="400" height="28" rx="6" fill="#161616"/>
  <text x="145" y="65" fill="#666" font-family="monospace" font-size="12">https://shivamwebdesigns.devs.li/works/chrono-luxury</text>
  <rect x="1030" y="48" width="110" height="24" rx="4" fill="#1e1e1e"/>
  <text x="1085" y="64" fill="#aaa" font-family="monospace" font-size="11" text-anchor="middle">VIP Concierge</text>

  <!-- Editorial layout grid inside mockup -->
  <g transform="translate(80, 160)">
    <text x="0" y="40" fill="#888888" font-family="monospace" font-size="14" letter-spacing="0.2em">CASE STUDY // SHIVAMWEBDESIGNS</text>
    <text x="0" y="110" fill="#ffffff" font-family="system-ui, sans-serif" font-weight="800" font-size="48" letter-spacing="-0.03em">CHRONO HOROLOGY</text>
    <text x="0" y="160" fill="#aaaaaa" font-family="system-ui, sans-serif" font-size="22">Haute Horlogerie Swiss Boutique</text>
    <line x1="0" y1="210" x2="600" y2="210" stroke="#262626" stroke-width="1.5"/>
    <text x="0" y="250" fill="#ffffff" font-family="monospace" font-size="14">STACK: React • TypeScript • Macro Zoom</text>
  </g>

  <!-- Geometric Abstract Visual Element -->
  <g transform="translate(820, 360)">
    <circle cx="0" cy="0" r="160" stroke="#222" stroke-width="1.5" fill="none"/>
    <circle cx="0" cy="0" r="100" stroke="#333" stroke-width="1.5" stroke-dasharray="4 4" fill="none"/>
    <circle cx="0" cy="0" r="40" fill="#ffffff" fill-opacity="0.05" stroke="#555" stroke-width="1"/>
    <line x1="-160" y1="0" x2="160" y2="0" stroke="#262626" stroke-width="1"/>
    <line x1="0" y1="-160" x2="0" y2="160" stroke="#262626" stroke-width="1"/>
  </g>
</svg>